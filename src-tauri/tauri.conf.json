{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerfMon OBS",
  "version": "1.1.0",
  "identifier": "com.perfmon.obs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PerfMon OBS",
        "width": 300,
        "height": 490,
        "minWidth": 180,
        "minHeight": 60,
        "maxWidth": 900,
        "maxHeight": 1470,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}